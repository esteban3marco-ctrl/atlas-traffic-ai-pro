<?xml version="1.0" encoding="UTF-8"?>
<!-- ATLAS Pro — Milán Centro Noche -->
<configuration>
    <input>
        <net-file value="milan.net.xml"/>
        <route-files value="routes_noche.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="7200"/>
        <step-length value="0.1"/>
    </time>
    <processing>
        <collision.action value="warn"/>
        <time-to-teleport value="180"/>
        <max-depart-delay value="120"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="true"/>
    </report>
</configuration>
